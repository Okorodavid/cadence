# ── Higgsfield (the only image/video provider) ──────────────────────────────
# https://console.higgsfield.ai  ->  API keys
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# HF_API_BASE=https://api.higgsfield.ai
# Parallel Higgsfield requests. Start at 2.
HF_CONCURRENCY=2

# MOCK=true renders everything locally with ffmpeg and spends zero credits.
# Leave it true until demo day. Unset + no keys also falls back to mock.
MOCK=true

# ── Spend guard (live only) ─────────────────────────────────────────────────
# Weekly USD cap on Higgsfield generation. A job that would exceed it is
# refused before any API call. 0 / unset = no cap (a warning is logged).
# Set this before MOCK=false on a public URL. ~$25 covers the minimum demo.
SPEND_CAP_USD_PER_WEEK=30
# Estimate inputs (tune to the real prices on your Higgsfield console):
# PRICE_IMAGE_USD=0.094
# PRICE_VIDEO_USD_PER_SEC=0.19

# ── Scripts, topics, titles (text only) ─────────────────────────────────────
# Without this, every writer falls back to a built-in template and the app
# still produces complete jobs.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Voice ───────────────────────────────────────────────────────────────────
# Auto-picked: elevenlabs if the key is set, else Windows SAPI, else silence.
# TTS_PROVIDER=sapi
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# SAPI_VOICE=Microsoft David Desktop

# ── Storage / db ────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
# Where rendered media lives. Default: public/media. In production set this to a
# path OUTSIDE the repo (a mounted volume) so renders survive redeploys; the
# /media route streams from here.
# MEDIA_ROOT=./storage/media

# ── App ─────────────────────────────────────────────────────────────────────
# Leave blank to run with no login. Set it and the whole app is gated.
APP_PASSWORD=
# Skip the review step and send finished renders straight to `ready`.
AUTO_APPROVE=false
# Override if ffmpeg is not on PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=
# CAPTION_FONT_PATH=

# Permanent public address via Cloudflare Tunnel, e.g. cadence.yourdomain.com.
# Dev mode only accepts requests from hosts it knows about.
# PUBLIC_HOSTNAME=
