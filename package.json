    "hf:test": "tsx index.ts",
    "demo": "tsx worker/demo.ts",
    "demo:rerender": "tsx worker/demo.ts --rerender",
    "demo:fresh": "tsx worker/demo.ts --fresh"
  },
  "dependencies": {
